{
  "name": "yunsuo-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "云梭网盘转存 Windows 桌面客户端",
  "main": "src/main.js",
  "author": "Yunsuo",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.yunsuo.desktop",
    "productName": "云梭桌面端",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "YunsuoDesktop-${version}.${ext}"
    }
  }
}
